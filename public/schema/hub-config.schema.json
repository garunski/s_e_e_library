{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://garunski.github.io/s_e_e_library/schema/hub-config.schema.json",
  "title": "Hub config.json",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "experimental_features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orchestrator": {
              "type": "boolean",
              "default": false
            },
            "orchestrator_cycle": {
              "type": "boolean",
              "default": false
            },
            "knowledge_cycle": {
              "type": "boolean",
              "default": false
            },
            "planning_cycle": {
              "type": "boolean",
              "default": false
            },
            "knowledge_research": {
              "type": "boolean",
              "default": false
            },
            "global_chat": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "id": {
          "type": "string"
        },
        "admin_spoke": {
          "type": "string"
        },
        "spokes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "default_command_id": {
          "type": "string"
        },
        "default_workflow_by_command": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "overrides": {
      "type": "object"
    },
    "stories": {
      "type": "object"
    },
    "library": {
      "type": "object"
    },
    "llm": {
      "type": "object"
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cycle_enabled": {
          "type": "boolean"
        }
      }
    },
    "orchestrator": {
      "type": "object"
    }
  }
}
