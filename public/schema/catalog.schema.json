{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garunski.github.io/s_e_e_library/schema/catalog.schema.json",
  "title": "S.E.E. Library catalog manifest",
  "type": "object",
  "required": ["schema", "name", "packages"],
  "properties": {
    "schema": { "enum": ["see.library/v1", "see.library/v2"] },
    "name": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "stacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/stack" }
    },
    "featuredStackId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "category",
        "version",
        "author",
        "verified",
        "license",
        "requires",
        "dependencies",
        "files"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "workflow",
            "prompt",
            "skill",
            "rule",
            "template",
            "command",
            "bundle",
            "cycle"
          ]
        },
        "version": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "verified": { "type": "boolean" },
        "license": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "toolIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "releases": {
          "type": "array",
          "items": { "$ref": "#/$defs/release" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["to", "from"],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(\\.s_e_e/|\\.agents/|\\.cursor/|templates/)[^\\\\]*$"
        },
        "from": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "date", "note"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "required": ["id", "name", "sharedPackageIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sharedPackageIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["toolId", "packageIds"],
      "properties": {
        "toolId": { "type": "string", "minLength": 1 },
        "packageIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
