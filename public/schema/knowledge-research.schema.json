{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S.E.E. Research Markdown tree",
  "type": "object",
  "properties": {
    "root": {
      "$ref": "#/$defs/MarkdownRecord_RootMetadata"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarkdownPage"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "root",
    "pages"
  ],
  "$defs": {
    "MarkdownRecord_RootMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/RootMetadata"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "body"
      ]
    },
    "RootMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "short_description",
        "tags"
      ]
    },
    "MarkdownPage": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/MarkdownRecord_PageMetadata"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkdownRecord_SectionMetadata"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "page",
        "sections"
      ]
    },
    "MarkdownRecord_PageMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/PageMetadata"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "body"
      ]
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "short_description",
        "sections",
        "sources"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "link"
      ]
    },
    "MarkdownRecord_SectionMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/SectionMetadata"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "metadata",
        "body"
      ]
    },
    "SectionMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "evidence"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sources"
      ]
    },
    "ResearchRecordKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
    },
    "FilterPredicate": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOperator"
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "field",
        "op"
      ]
    },
    "FilterOperator": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "in",
        "not_in",
        "contains",
        "contains_any",
        "contains_all",
        "contains_none",
        "gte",
        "lte",
        "is_set",
        "is_unset"
      ]
    },
    "knowledge_research_list_request_schema": {
      "required": [
        "project"
      ],
      "title": "List",
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ResearchRecordKey"
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "filters": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/FilterPredicate"
          }
        }
      },
      "additionalProperties": false
    },
    "DocumentSummary": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "title",
        "short_description",
        "tags",
        "page_count",
        "token"
      ]
    },
    "knowledge_research_list_response_schema": {
      "required": [
        "items",
        "limit"
      ],
      "title": "SummaryPage_DocumentSummary",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSummary"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      }
    },
    "knowledge_research_search_request_schema": {
      "required": [
        "project",
        "query"
      ],
      "title": "Search",
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ResearchRecordKey"
        },
        "query": {
          "type": "string",
          "maxLength": 256
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "document": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "SearchHit": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        }
      },
      "required": [
        "document",
        "page",
        "section",
        "title",
        "snippet"
      ]
    },
    "knowledge_research_search_response_schema": {
