{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://garunski.github.io/s_e_e_library/schema/orchestrator-policy.schema.json",
  "title": "Orchestrator policy document",
  "type": "object",
  "required": [
    "policy",
    "budgets"
  ],
  "additionalProperties": true,
  "properties": {
    "auto_mode": {
      "enum": [
        "off",
        "assisted",
        "auto"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "levels": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "auto",
              "propose",
              "forbid"
            ]
          }
        }
      }
    },
    "budgets": {
      "type": "object"
    }
  }
}
