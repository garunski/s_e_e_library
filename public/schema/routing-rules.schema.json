{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://garunski.github.io/s_e_e_library/schema/routing-rules.schema.json",
  "title": "LLM routing rules",
  "type": "object",
  "required": [
    "task_profiles"
  ],
  "additionalProperties": true,
  "properties": {
    "task_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "additionalProperties": true,
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string"
          },
          "requires_tool_calling": {
            "type": "boolean"
          }
        }
      }
    },
    "cost_caps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "max_usd"
        ],
        "properties": {
          "max_usd": {
            "type": "number"
          }
        }
      }
    }
  }
}
