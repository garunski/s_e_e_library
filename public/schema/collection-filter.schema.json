{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garunski.github.io/s_e_e_library/schema/collection-filter.schema.json",
  "title": "S.E.E. collection filter request",
  "description": "Shared optional selection member for existing collection requests. Collection descriptors constrain fields, operators, enum choices and nullability. Decoded serialized filters are bounded to 16384 UTF-8 bytes. Project, legacy selection and pagination belong to each operation's own contract.",
  "type": "object",
  "properties": {
    "filters": {
      "type": ["array", "null"],
      "maxItems": 16,
      "items": { "$ref": "#/$defs/predicate" }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 1024 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "predicate": {
      "type": "object",
      "required": ["field", "op"],
      "properties": {
        "field": { "type": "string" },
        "op": {
          "enum": ["eq", "ne", "in", "not_in", "contains", "contains_any", "contains_all", "contains_none", "gte", "lte", "is_set", "is_unset"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/scalar" } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["is_set", "is_unset"] } } },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        },
        {
          "if": { "properties": { "op": { "enum": ["in", "not_in", "contains_any", "contains_all", "contains_none"] } } },
          "then": { "properties": { "value": { "type": "array" } } },
          "else": { "properties": { "value": { "$ref": "#/$defs/scalar" } } }
        }
      ]
    }
  }
}
