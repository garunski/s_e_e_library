{
  "id": "system-scope-planning",
  "name": "Scope planning milestone",
  "description": "Read the validated manifest with item_fetch. Do not create stories. Do not mark work Done. Do not start implementation.",
  "content": {
    "id": "system-scope-planning",
    "name": "Scope planning milestone",
    "description": "Confirm the milestone cut, then persist it. Drafts are not evidence.",
    "runtime_inputs": [
      {
        "key": "manifest",
        "input_type": "string",
        "required": true,
        "label": "Planning manifest JSON"
      },
      {
        "key": "run_id",
        "input_type": "string",
        "required": true,
        "label": "Planning run id"
      }
    ],
    "tasks": [
      {
        "id": "validate",
        "name": "Bind validated manifest",
        "capture_output": true,
        "function": {
          "name": "planning_manifest",
          "input": {
            "manifest_runtime_key": "manifest"
          }
        },
        "next_tasks": [
          {
            "id": "read",
            "name": "Read the current milestone",
            "function": {
              "name": "command",
              "input": {
                "prompt": "You are the Scope stage. The validated manifest is already bound for run {{runtime.run_id}}. Use item_fetch to read the current milestones. Do not call item_call. Do not create a story. Do not mark work Done. Do not start implementation. Reply with the milestone outcome from the validated manifest."
              }
            },
            "next_tasks": [
              {
                "id": "scope",
                "name": "Persist the milestone cut",
                "capture_output": true,
                "function": {
                  "name": "planning_suite",
                  "input": {
                    "operation": "scope",
                    "manifest_runtime_key": "",
                    "run_runtime_key": "run_id"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
