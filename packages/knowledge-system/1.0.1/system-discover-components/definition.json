{
  "id": "system-discover-components",
  "name": "Discover project components",
  "description": "For the current Knowledge Cycle project, inspect its registered spokes, write each component record, then delete obsolete records.",
  "labels": [
    "knowledge"
  ],
  "content": {
    "id": "discover-project-components",
    "name": "Discover project components",
    "runtime_inputs": [],
    "tasks": [
      {
        "id": "define_components",
        "name": "Define project components",
        "capture_output": true,
        "function": {
          "name": "command",
          "input": {
            "prompt": "{{prompt.system-discover-components-project}}",
            "config": {
              "timeout_secs": 7200
            }
          }
        },
        "next_tasks": [
          {
            "id": "for_each_component",
            "name": "For each component",
            "run_when": {
              "task": "define_components",
              "path": [
                "scan_complete"
              ],
              "op": "eq",
              "value": true
            },
            "function": {
              "name": "foreach",
              "input": {
                "collection_task_id": "define_components",
                "collection_task_path": [
                  "component_names"
                ],
                "item_runtime_key": "component_name"
              }
            },
            "next_tasks": [
              {
                "id": "write_component",
                "name": "Write component record",
                "capture_output": true,
                "function": {
                  "name": "command",
                  "input": {
                    "prompt": "{{prompt.system-discover-components-detail}}",
                    "config": {
                      "timeout_secs": 3600
                    }
                  }
                },
                "next_tasks": []
              }
            ]
          },
          {
            "id": "list_components_for_prune",
            "name": "List component records",
            "capture_output": true,
            "wait_for": [
              "for_each_component"
            ],
            "run_when": {
              "op": "eq",
              "path": [
                "scan_complete"
              ],
              "task": "define_components",
              "value": true
            },
            "function": {
              "name": "s_e_e_action",
              "input": {
                "tool": "knowledge_component_list",
                "arguments": {}
              }
            },
            "next_tasks": [
              {
                "capture_output": true,
                "function": {
                  "name": "command",
                  "input": {
                    "command_id": "workflow-select-obsolete-components",
                    "config": {
                      "names": "{{task.define_components.output.component_names}}",
                      "records": "{{task.list_components_for_prune.output}}"
                    }
                  }
                },
                "id": "select_deletions",
                "name": "Select obsolete records",
                "next_tasks": [
                  {
                    "function": {
                      "input": {
                        "collection_task_id": "select_deletions",
                        "collection_task_path": [
                          "delete_ids"
                        ],
                        "item_runtime_key": "delete_component_id"
                      },
                      "name": "foreach"
                    },
                    "id": "for_each_deletion",
                    "name": "For each obsolete record",
                    "next_tasks": [
                      {
                        "capture_output": true,
                        "function": {
                          "input": {
                            "arguments": {
                              "id": "{{runtime.delete_component_id}}",
                              "kind": "knowledge_component"
                            },
                            "tool": "item_fetch"
                          },
                          "name": "s_e_e_action"
                        },
                        "id": "fetch_component",
                        "name": "Read component record",
                        "next_tasks": [
                          {
                            "function": {
                              "input": {
                                "arguments": {
                                  "action": "knowledge_component_delete",
                                  "arguments": {
                                    "confirm": true,
                                    "conflict_token": "{{task.fetch_component.output.item.conflict_token}}"
                                  },
                                  "id": "{{runtime.delete_component_id}}",
                                  "kind": "knowledge_component"
                                },
                                "tool": "item_call"
                              },
                              "name": "s_e_e_action"
                            },
                            "id": "delete_component",
                            "name": "Delete component record",
                            "next_tasks": []
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
