{
  "id": "system-work-swimlane-stories",
  "name": "Work swimlane stories",
  "description": "Fetches every story in a board swimlane (status column), then Runs the project's agent command executing the /work skill on each story in a loop.",
  "content": {
    "id": "work-swimlane-stories",
    "name": "Work swimlane stories",
    "runtime_inputs": [
      {
        "input_type": "string",
        "key": "swimlane",
        "label": "Board swimlane (status)",
        "required": true
      }
    ],
    "tasks": [
      {
        "capture_output": true,
        "function": {
          "input": {
            "tool": "item_call",
            "arguments": {
              "project": "{{project.id}}",
              "kind": "story",
              "action": "story_list",
              "arguments": {
                "status": "{{runtime.swimlane}}"
              }
            }
          },
          "name": "s_e_e_action"
        },
        "id": "resolve_story_ids",
        "name": "Resolve story ids for swimlane",
        "next_tasks": [
          {
            "function": {
              "input": {
                "collection_task_id": "resolve_story_ids",
                "collection_task_path": [
                  "story_ids"
                ],
                "item_runtime_key": "story_id"
              },
              "name": "foreach"
            },
            "id": "for_each_story",
            "name": "For each story",
            "next_tasks": [
              {
                "function": {
                  "input": {
                    "config": {},
                    "prompt": "{{prompt.system-work-story}}"
                  },
                  "name": "command"
                },
                "id": "work_story",
                "name": "Work story",
                "next_tasks": [
                  {
                    "function": {
                      "input": {
                        "args": [
                          "work skill finished for {{runtime.story_id}}; verify status: Done in the story file."
                        ],
                        "command": "echo"
                      },
                      "name": "cli_command"
                    },
                    "id": "report_done",
                    "name": "Report completion",
                    "next_tasks": []
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "is_edited": false,
  "labels": [
    "system"
  ],
  "created_at": "2026-07-05T00:11:36.910000000Z",
  "updated_at": "2026-07-05T00:11:36.910000000Z",
  "subject_kinds": [
    "story"
  ]
}
