{
  "id": "system-work-milestone-stories",
  "name": "Work milestone stories",
  "description": "Works every story in a milestone with the project's agent command, then runs the repository quality gate.",
  "version": "1.0.0",
  "labels": [
    "system"
  ],
  "content": {
    "id": "work-milestone-stories",
    "name": "Work milestone stories",
    "runtime_inputs": [
      {
        "key": "milestone_id",
        "label": "Milestone id",
        "input_type": "string",
        "required": true
      }
    ],
    "tasks": [
      {
        "id": "resolve_story_ids",
        "name": "Resolve story ids for milestone",
        "capture_output": true,
        "function": {
          "name": "s_e_e_action",
          "input": {
            "tool": "item_call",
            "arguments": {
              "project": "{{project.id}}",
              "kind": "story",
              "action": "story_list",
              "arguments": {
                "milestone_id": "{{runtime.milestone_id}}"
              }
            }
          }
        },
        "next_tasks": [
          {
            "id": "for_each_story",
            "name": "For each story",
            "function": {
              "name": "foreach",
              "input": {
                "collection_task_id": "resolve_story_ids",
                "collection_task_path": [
                  "story_ids"
                ],
                "item_runtime_key": "story_id"
              }
            },
            "next_tasks": [
              {
                "id": "work_story",
                "name": "Work story",
                "function": {
                  "name": "command",
                  "input": {
                    "config": {},
                    "prompt": "{{prompt.system-work-story}}"
                  }
                },
                "next_tasks": []
              }
            ]
          },
          {
            "id": "quality_pass",
            "name": "Run the repository quality gate",
            "wait_for": [
              "for_each_story"
            ],
            "function": {
              "name": "command",
              "input": {
                "config": {},
                "prompt": "Every story in milestone {{runtime.milestone_id}} has been worked. In `{{project.spoke_root}}`, run the completion quality gate named in the repository `AGENTS.md` and fix every failure until it passes. Do not change story or milestone records. If `AGENTS.md` names no quality gate, report that and stop. This runs headless: run every command to completion and leave no process running."
              }
            },
            "next_tasks": []
          }
        ]
      }
    ]
  },
  "subject_kinds": [
    "milestone"
  ]
}
